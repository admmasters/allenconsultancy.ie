---
import ContentLayout from "../../layouts/ContentLayout.astro";
import ServiceCard from "../../components/sections/ServiceCard.astro";
import Credentials from "../../components/sections/Credentials.astro";

const services = [
  {
    id: "consultancy",
    title: "Consultancy",
    description:
      "Debbie provides expert consultancy services to social workers and youth organisations, offering guidance on safeguarding policies and procedures.",
    detailedDescription:
      "Debbie can provide 1:1 consultations to support workers to identify their next steps in safety planning for children and young people, whether that is from within an organisation or their own home.",
    features: [
      "1:1 consultations with experienced professionals",
      "Safety planning guidance for complex cases",
      "Safeguarding policy development support",
      "Organisational risk assessment consultation",
      "Professional supervision and guidance",
    ],
    contactInfo: "085 778 4678",
    icon: "👥",
  },
  {
    id: "risk-assessment",
    title: "Risk Assessment",
    description:
      "Comprehensive risk assessments using evidence-based methodologies for adults and young people who have sexually harmed children.",
    detailedDescription:
      "Debbie has undergone extensive training in risk assessment tools, including AIM3, Stable & Acute 2007, and Risk Matrix 2000. She applies these methodologies to conduct comprehensive risk assessments that evaluate key risk factors and provide tailored recommendations for safety planning within child protection.",
    features: [
      "AIM3 Assessment Framework implementation",
      "Stable & Acute 2007 methodology",
      "Risk Matrix 2000 evaluations",
      "Comprehensive risk factor analysis",
      "Tailored safety planning recommendations",
      "Evidence-based assessment reports",
    ],
    methodologies: ["AIM3", "Stable & Acute 2007", "Risk Matrix 2000"],
    icon: "📋",
  },
  {
    id: "capacity-assessment",
    title: "Capacity to Protect Assessment",
    description:
      "Specialised assessments using the CASP-R framework to evaluate parental capacity to safeguard children from identified risks.",
    detailedDescription:
      "Debbie has successfully completed training in the Capacity and Ability to Supervise and Protect – Risk Framework (CASP-R) through McGibbon Consultancy. She utilises this framework to assess a parent's capacity to safeguard children from identified risks. These assessments evaluate the parent's protective abilities, identify areas for development, and support informed decision-making in child protection.",
    features: [
      "CASP-R framework implementation",
      "Parental protective capacity evaluation",
      "Risk-specific assessment protocols",
      "Development area identification",
      "Informed decision-making support",
      "Comprehensive assessment reporting",
    ],
    methodologies: ["CASP-R Framework"],
    icon: "🛡️",
  },
  {
    id: "training",
    title: "Training",
    description:
      "Bespoke training programmes for professionals working in child protection and safeguarding, tailored to organisational needs.",
    detailedDescription:
      "Debbie offers bespoke training to all professionals working in child protection and safeguarding. Her training programmes focus on enhancing the use of risk assessment tools, developing effective safety strategies, and strengthening collaboration across sectors.",
    features: [
      "Customised training programmes",
      "Risk assessment tool training",
      "Safety strategy development",
      "Cross-sector collaboration enhancement",
      "Professional development workshops",
      "Ongoing consultation support",
    ],
    previousTrainings: [
      "Understanding and Preventing CSA",
      "Safeguarding for Youth Organisations",
    ],
    icon: "🎓",
  },
];

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Allen Consultancy",
  description:
    "Independent social work consultancy specialising in child protection",
  provider: {
    "@type": "Person",
    name: "Debbie Allen",
    jobTitle: "Independent Social Worker",
    telephone: "+353857784678",
    email: "info@allenconsultancy.ie",
  },
  serviceType: [
    "Child Protection Consultation",
    "Risk Assessment",
    "Capacity to Protect Assessment",
    "Professional Training",
  ],
  areaServed: {
    "@type": "Country",
    name: "Ireland",
  },
  url: "https://allenconsultancy.ie/services",
};
---

<ContentLayout
  title="Professional Social Work Services | Child Protection Consultation"
  description="Expert social work consultancy services including risk assessments, capacity evaluations, and specialised training for child protection professionals."
  pageTitle="Professional Services"
  breadcrumbs={breadcrumbs}
>
  <!-- Services Introduction -->
  <section class="services-intro section">
    <div class="container">
      <div class="services-intro__content">
        <p class="services-intro__lead">
          Debbie Allen provides specialised social work consultancy services
          focused on child protection and safeguarding. With extensive training
          in evidence-based assessment tools and a trauma-informed approach, she
          supports organisations and professionals in creating safer
          environments for children and young people.
        </p>
        <div class="services-intro__highlights">
          <div class="highlight-item">
            <span class="highlight-item__number">4</span>
            <span class="highlight-item__text">Core Services</span>
          </div>
          <div class="highlight-item">
            <span class="highlight-item__number">10+</span>
            <span class="highlight-item__text">Years Experience</span>
          </div>
          <div class="highlight-item">
            <span class="highlight-item__number">100%</span>
            <span class="highlight-item__text">Professional Standards</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="services-grid section">
    <div class="container">
      <div class="services-grid__content">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.detailedDescription}
              features={service.features}
              contactInfo={service.contactInfo}
              icon={service.icon}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Professional Registrations & Memberships -->
  <Credentials size="small" layout="horizontal" showTitle={false} />

  <!-- Call to Action -->
  <section class="services-cta section">
    <div class="container">
      <div class="services-cta__content">
        <h2 class="services-cta__title">Ready to Get Started?</h2>
        <p class="services-cta__description">
          Contact Debbie Allen to discuss your specific needs and learn how her
          expertise can support your organisation's child protection and
          safeguarding goals.
        </p>
        <div class="services-cta__actions">
          <a href="/contact" class="btn btn--primary btn--large">
            Get in Touch
          </a>
          <div class="services-cta__contact">
            <p class="services-cta__contact-item">
              <strong>Phone:</strong>
              <a href="tel:+353857784678">085 778 4678</a>
            </p>
            <p class="services-cta__contact-item">
              <strong>Email:</strong>
              <a href="mailto:info@allenconsultancy.ie"
                >info@allenconsultancy.ie</a
              >
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
</ContentLayout>

<style>
  /* Services Introduction */
  .services-intro {
    background: #f8fafc;
  }

  .services-intro__content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .services-intro__lead {
    font-size: 1.125rem;
    color: #374151;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .services-intro__highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .highlight-item__number {
    font-size: 2rem;
    font-weight: 700;
    color: #1d4ed8;
  }

  .highlight-item__text {
    font-size: 0.875rem;
    color: #6b7280;
    font-weight: 500;
  }

  /* Services Grid */
  .services-grid {
    background: #ffffff;
  }

  .services-grid__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Services CTA */
  .services-cta {
    background: #1e40af;
    color: #ffffff;
  }

  .services-cta__content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .services-cta__title {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .services-cta__description {
    font-size: 1.125rem;
    color: #ffffff;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .services-cta__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .services-cta__contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: #ffffff;
  }

  .services-cta__contact-item {
    font-size: 1rem;
  }

  .services-cta__contact-item a {
    color: #ffffff;
    text-decoration: underline;
    text-decoration-color: transparent;
    transition: all 0.2s ease;
  }

  .services-cta__contact-item a:hover,
  .services-cta__contact-item a:focus {
    text-decoration-color: currentColor;
    outline: 3px solid #fbbf24;
    outline-offset: 2px;
    border-radius: 2px;
    padding: 0.25rem 0.5rem;
  }

  /* Responsive Design */
  @media (min-width: 640px) {
    .services-cta__contact {
      flex-direction: row;
      gap: 2rem;
    }
  }

  @media (min-width: 768px) {
    .services-grid__content {
      grid-template-columns: repeat(2, 1fr);
    }

    .services-intro__highlights {
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .services-intro__highlights {
      grid-template-columns: repeat(3, 1fr);
      max-width: 600px;
      margin: 2rem auto 0;
    }
  }

  @media (max-width: 768px) {
    .services-intro__highlights {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .highlight-item__number {
      font-size: 1.5rem;
    }

    .services-cta__title {
      font-size: 1.5rem;
    }

    .services-cta__description {
      font-size: 1rem;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .services-cta {
      background: #1e3a8a;
    }
  }
</style>
