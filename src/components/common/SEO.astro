---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title = 'Independent Social Worker | Child Protection Consultant | Debbie Allen',
  description = 'Expert social work consultancy specialising in child protection, risk assessments, and safeguarding. Professional services for organisations across Ireland. Contact Debbie Allen for specialised consultation.',
  canonical,
  noindex = false,
  ogImage = '/images/debbie-profile.jpg'
} = Astro.props;

const fullTitle = title === 'Independent Social Worker | Child Protection Consultant | Debbie Allen' 
  ? title 
  : `${title} | Debbie Allen - Social Work Consultant`;

const siteURL = 'https://allenconsultancy.ie';
const canonicalURL = canonical || (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : `${siteURL}${Astro.url.pathname}`);
const fullOgImage = Astro.site ? new URL(ogImage, Astro.site).toString() : `${siteURL}${ogImage}`;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{fullTitle}</title>
<meta name="description" content={description} />

{!noindex && <meta name="robots" content="index, follow" />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:site_name" content="Allen Consultancy" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullOgImage} />

<!-- Additional meta tags -->
<meta name="author" content="Debbie Allen" />
<meta name="keywords" content="social work, child protection, risk assessment, safeguarding, consultation, Ireland, AIM3, CASP-R, training" />

<!-- Professional service schema markup -->
<script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Allen Consultancy",
    "description": description,
    "url": siteURL,
    "image": fullOgImage,
    "provider": {
      "@type": "Person",
      "name": "Debbie Allen",
      "jobTitle": "Independent Social Worker & Child Protection Consultant",
      "image": Astro.site ? new URL('/images/debbie-profile.jpg', Astro.site).toString() : `${siteURL}/images/debbie-profile.jpg`,
      "telephone": "+353857784678",
      "email": "info@allenconsultancy.ie"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Ireland"
    },
    "serviceType": [
      "Child Protection Consultation",
      "Risk Assessment",
      "Capacity Assessment", 
      "Social Work Training",
      "Safeguarding Consultation"
    ],
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "IE"
    }
  }
</script>