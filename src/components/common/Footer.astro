---
const currentYear = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer__container">
    <div class="footer__content">
      <div class="footer__section footer__section--main">
        <h3 class="footer__title">Allen Consultancy</h3>
        <p class="footer__description">
          Social work consultancy specialising in child protection, risk
          assessments, and safeguarding services across Ireland.
        </p>
        <div class="footer__contact">
          <p class="footer__contact-item">
            <span class="footer__contact-label">Phone:</span>
            <a href="tel:+353857784678" class="footer__contact-link">
              085 778 4678
            </a>
          </p>
          <p class="footer__contact-item">
            <span class="footer__contact-label">Email:</span>
            <a
              href="mailto:info@allenconsultancy.ie"
              class="footer__contact-link"
            >
              info@allenconsultancy.ie
            </a>
          </p>
        </div>
      </div>

      <div class="footer__section footer__section--services">
        <h4 class="footer__section-title">Services</h4>
        <ul class="footer__link-list">
          <li>
            <a href="/services/consultancy" class="footer__link">Consultancy</a>
          </li>
          <li>
            <a href="/services/risk-assessment" class="footer__link"
              >Risk Assessment</a
            >
          </li>
          <li>
            <a href="/services/capacity-assessment" class="footer__link"
              >Capacity Assessment</a
            >
          </li>
          <li>
            <a href="/services/training" class="footer__link">Training</a>
          </li>
        </ul>
      </div>

      <div class="footer__section footer__section--company">
        <h4 class="footer__section-title">Company</h4>
        <ul class="footer__link-list">
          <li><a href="/" class="footer__link">About Me</a></li>
          <li><a href="/contact" class="footer__link">Contact</a></li>
          <li><a href="/privacy" class="footer__link">Privacy Policy</a></li>
          <li><a href="/terms" class="footer__link">Terms of Service</a></li>
        </ul>
      </div>

      <div class="footer__section footer__section--credentials">
        <h4 class="footer__section-title">Professional Memberships</h4>
        <ul class="footer__credentials">
          <li class="footer__credential">CORU Registered</li>
          <li class="footer__credential">NOTA Member</li>
          <li class="footer__credential">IASW Member</li>
          <li class="footer__credential">SAARNA Member</li>
          <li class="footer__credential">NAGALRO Member</li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__copyright">
        <p>&copy; {currentYear} Allen Consultancy. All rights reserved.</p>
        <p class="footer__disclaimer">
          Professional social work consultation services. Registered and insured
          practitioner.
        </p>
      </div>
      <div class="footer__compliance">
        <p class="footer__compliance-text">
          Compliant with professional social work standards and regulations.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Professional Footer Styles */
  .footer {
    background: #111827;
    color: #ffffff;
    margin-top: auto;
  }

  .footer__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .footer__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer__section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__section--main {
    /* Main section spans full width on mobile */
  }

  .footer__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .footer__description {
    color: #d1d5db;
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Improved Contact Information Styling */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .footer__contact-label {
    color: #ffffff;
    font-weight: 500;
    min-width: 4rem;
  }

  .footer__contact-link {
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .footer__contact-link:hover,
  .footer__contact-link:focus {
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.1);
    outline: 2px solid #60a5fa;
    outline-offset: 2px;
  }

  .footer__section-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .footer__link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__link {
    color: #d1d5db;
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s ease;
    padding: 0.25rem 0;
  }

  .footer__link:hover,
  .footer__link:focus {
    color: #ffffff;
    outline: 2px solid #60a5fa;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .footer__credentials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__credential {
    color: #d1d5db;
    font-size: 0.875rem;
    position: relative;
    padding-left: 1rem;
  }

  .footer__credential::before {
    content: "✓";
    color: #10b981;
    position: absolute;
    left: 0;
    font-weight: bold;
  }

  .footer__bottom {
    border-top: 1px solid #374151;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__copyright {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__copyright p {
    font-size: 0.875rem;
    color: #9ca3af;
    margin: 0;
  }

  .footer__disclaimer {
    font-size: 0.75rem;
    color: #6b7280;
  }

  .footer__compliance {
    margin-top: 1rem;
  }

  .footer__compliance-text {
    font-size: 0.75rem;
    color: #6b7280;
    text-align: left;
  }

  /* Responsive Design */
  @media (min-width: 640px) {
    .footer__contact {
      flex-direction: row;
      gap: 2rem;
    }

    .footer__contact-item {
      flex-direction: row;
    }
  }

  @media (min-width: 768px) {
    .footer__content {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }

    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .footer__compliance {
      margin-top: 0;
    }

    .footer__compliance-text {
      text-align: right;
    }
  }

  @media (min-width: 1024px) {
    .footer__content {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
    }

    .footer__section--main {
      /* Main section takes up 2 columns on desktop */
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .footer {
      background: #000000;
      border-top: 2px solid #ffffff;
    }

    .footer__contact-link:hover,
    .footer__contact-link:focus {
      background: #ffffff;
      color: #000000;
    }
  }
</style>
