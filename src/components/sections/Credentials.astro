---
export interface Props {
  showTitle?: boolean;
  layout?: "horizontal" | "vertical";
  size?: "small" | "medium" | "large";
}

const {
  showTitle = true,
  layout = "horizontal",
  size = "medium",
} = Astro.props;

const credentials = [
  {
    name: "CORU",
    fullName: "Health and Social Care Professionals Council",
    description: "Registered Social Worker",
    priority: "primary",
    url: "https://coru.ie/",
  },
  {
    name: "NOTA",
    fullName: "National Organisation for the Treatment of Abusers",
    description: "Professional Member",
    priority: "secondary",
    url: "https://nota.co.uk/",
  },
  {
    name: "IASW",
    fullName: "Irish Association of Social Workers",
    description: "Professional Member",
    priority: "secondary",
    url: "https://www.iasw.ie/",
  },
  {
    name: "SAARNA",
    fullName: "Sexual Abuse and Rape National Association",
    description: "Professional Member",
    priority: "secondary",
    url: "https://saarna.ie/",
  },
  {
    name: "NAGALRO",
    fullName:
      "National Association of Guardians ad Litem and Reporting Officers",
    description: "Professional Member",
    priority: "secondary",
    url: "https://www.nagalro.com/",
  },
];
---

<section
  class={`credentials credentials--${layout} credentials--${size}`}
  aria-labelledby="credentials-heading"
>
  {
    showTitle && (
      <h2 id="credentials-heading" class="credentials__title">
        Professional Registrations & Memberships
      </h2>
    )
  }

  <div class="credentials__grid">
    {
      credentials.map((credential) => (
        <div
          class={`credentials__item credentials__item--${credential.priority}`}
        >
          <div class="credentials__content">
            <h3 class="credentials__name">{credential.name}</h3>
            <p class="credentials__full-name">{credential.fullName}</p>
            <p class="credentials__description">{credential.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .credentials {
    padding: 2rem 0;
  }

  .credentials__title {
    font-size: 1.875rem;
    font-weight: 700;
    color: #1d4ed8;
    margin-bottom: 2rem;
    text-align: center;
  }

  .credentials__grid {
    display: grid;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .credentials--horizontal .credentials__grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .credentials--vertical .credentials__grid {
    grid-template-columns: 1fr;
    max-width: 600px;
  }

  .credentials__item {
    background: #ffffff;
    border: 2px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1.5rem;
    transition: all 0.3s ease;
    position: relative;
  }

  .credentials__item:hover {
    border-color: #1d4ed8;
    box-shadow: 0 4px 12px rgba(29, 78, 216, 0.1);
    transform: translateY(-2px);
  }

  .credentials__item--primary {
    border-color: #1d4ed8;
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  }

  .credentials__item--primary::before {
    content: "Primary Registration";
    position: absolute;
    top: -0.5rem;
    left: 1rem;
    background: #1d4ed8;
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .credentials__content {
    text-align: center;
  }

  .credentials__name {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1d4ed8;
    margin-bottom: 0.5rem;
  }

  .credentials__full-name {
    font-size: 0.875rem;
    color: #4b5563;
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .credentials__description {
    font-size: 1rem;
    color: #059669;
    font-weight: 600;
    margin: 0;
  }

  /* Small size variant */
  .credentials--small .credentials__title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .credentials--small .credentials__item {
    padding: 1rem;
  }

  .credentials--small .credentials__name {
    font-size: 1.25rem;
  }

  .credentials--small .credentials__full-name {
    font-size: 0.75rem;
  }

  .credentials--small .credentials__description {
    font-size: 0.875rem;
  }

  /* Large size variant */
  .credentials--large .credentials__title {
    font-size: 2.25rem;
    margin-bottom: 3rem;
  }

  .credentials--large .credentials__item {
    padding: 2rem;
  }

  .credentials--large .credentials__name {
    font-size: 1.75rem;
  }

  .credentials--large .credentials__full-name {
    font-size: 1rem;
  }

  .credentials--large .credentials__description {
    font-size: 1.125rem;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .credentials {
      padding: 1.5rem 0;
    }

    .credentials__grid {
      gap: 1rem;
    }

    .credentials--horizontal .credentials__grid {
      grid-template-columns: 1fr;
    }

    .credentials__item {
      padding: 1.25rem;
    }

    .credentials__title {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .credentials__name {
      font-size: 1.25rem;
    }
  }
</style>
